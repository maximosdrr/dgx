NODE_ENV=local

# Database
DATABASE_URL=postgresql://user:password@ep-xxx.us-east-1.aws.neon.tech/docgen?sslmode=require

# JWT
JWT_SECRET=super-secret-change-in-prod
JWT_ACCESS_EXPIRES=15m
JWT_REFRESH_EXPIRES=7d

# AWS
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
S3_BUCKET=docgen-documents

# App
PORT=3001

# AbacatePay
ABACATEPAY_API_KEY=abacatepay_xxx
ABACATEPAY_WEBHOOK_SECRET=
APP_URL=http://localhost:3000

# PDF — local dev only (Lambda usa o @sparticuz/chromium layer)
# macOS:  /Applications/Google Chrome.app/Contents/MacOS/Google Chrome
# Linux:  /usr/bin/google-chrome-stable
CHROME_EXECUTABLE_PATH=/Applications/Google Chrome.app/Contents/MacOS/Google Chrome
